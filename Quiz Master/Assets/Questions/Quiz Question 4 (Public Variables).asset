  m_Script: {fileID: 11500000, guid: 2fce283e6d2030d42a8c34fc2e538818, type: 3}
  m_Name: Quiz Question 4 (Public Variables)
  m_EditorClassIdentifier: 
  question: When should you declare a variable as public?
  answers:
  - When it needs to be accessed from other scripts or classes.
  - To limit its use within the same method.
  - To prevent other scripts from using it.
  - To delete the variable automatically.
  correctAnswerIndex: 0
  explanation: 'Making variables public allows them to be accessed from other scripts
    and classes. '
